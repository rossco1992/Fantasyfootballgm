# =============================================================================
# Fantasy Football GM — Environment Variables
# =============================================================================
#
# Copy this file to `.env.local` and fill in real values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored and MUST NOT be committed. Only this
# `.env.example` file (with placeholder values, no real secrets) is tracked.
#
# Naming / exposure strategy (see docs/adr and the Technical Architecture):
#   - Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle
#     and are therefore PUBLIC. Only put non-secret, publishable values here.
#   - All other variables are SERVER-ONLY. They are never sent to the browser
#     and are used for privileged operations (service-role DB access, provider
#     credentials, etc.). Access them through lib/env.ts, not process.env.
#
# Validation: values are validated at runtime by `lib/env.ts` (Zod). Missing or
# malformed values fail fast with a descriptive error.
# -----------------------------------------------------------------------------

# --- Supabase (public / browser-safe) ---------------------------------------
# Project URL and the publishable key (the legacy anon key also works). Safe to
# expose to the client.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Supabase (server-only / SECRET) ----------------------------------------
# Service-role key for privileged, server-side operations ONLY.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Database (server-only / SECRET) ----------------------------------------
# Direct Postgres connection string, used by the persistence layer (db/) and by
# the migration/seed scripts (db:migrate, db:seed, db:reset). This is the
# database's connection URL and contains a password — keep it server-only.
#
#   - Supabase (hosted): Project Settings → Database → Connection string (URI).
#   - Supabase (local `supabase start`): the CLI prints a "DB URL", typically
#       postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Yahoo Fantasy API validation (server-only / SECRET) --------------------
# NOC-52 local validation harness only. Yahoo currently reviews Fantasy Sports
# API access applications; configure these only after the app is approved and
# a Client ID/Secret has been issued. Never paste credentials or OAuth tokens
# into GitHub, Linear, or chat.
YAHOO_CLIENT_ID="your-yahoo-client-id"
YAHOO_CLIENT_SECRET="your-yahoo-client-secret"
YAHOO_REDIRECT_URI="https://your-approved-domain.example/yahoo/callback"

# One-time OAuth callback inputs. `npm run yahoo:auth-url` stores the expected
# OAuth state locally; place the returned code and state here only long enough to
# run `npm run yahoo:validate`, then remove them.
YAHOO_AUTHORIZATION_CODE=""
YAHOO_RETURNED_STATE=""

# Optional alternatives for an already-authorized development account. The
# validation script never prints tokens and stores a rotated refresh token only
# in the git-ignored `.yahoo-validation/` directory with owner-only permissions.
YAHOO_ACCESS_TOKEN=""
YAHOO_REFRESH_TOKEN=""

# Optional explicit scope. When omitted, the probe discovers the newest NFL
# league and a team key from the authenticated account.
YAHOO_LEAGUE_KEY=""
YAHOO_TEAM_KEY=""
YAHOO_WEEK=""
